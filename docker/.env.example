# Local development only — credentials come from ECS task role in production
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# From: terraform output raw_bucket
BUCKET_NAME_RAW=video-transcoder-dhruvan-patel-dev-raw-videos

# From: terraform output processed_bucket
BUCKET_NAME_TRANSCODED=video-transcoder-dhruvan-patel-dev-processed-videos

# S3 object key to transcode (passed as task override in ECS, set here for local dev)
KEY=your-video.mp4

# From: terraform output redis_endpoint — used for per-job status tracking.
# Format: redis://<host>:6379  (leave blank locally to skip status writes)
REDIS_URI=
