# Backend environment variables example
# Copy this to .env and fill the values for local development

# AWS credentials (local dev only — use IAM roles in production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# From: terraform output queue_url
QUEUE_URL=YOUR_SQS_QUEUE_URL

# From: terraform output ecs_cluster_arn
ECS_CLUSTER_ARN=arn:aws:ecs:ap-south-1:ACCOUNT_ID:cluster/CLUSTER_NAME

# From: terraform output ecs_task_definition_arn
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:ap-south-1:ACCOUNT_ID:task-definition/FAMILY:REVISION

# From: terraform output ecs_subnet_ids (comma-separated)
ECS_SUBNETS=subnet-xxxxxxx,subnet-yyyyyyy

# App port
PORT=3000
