# Backend environment variables example
# Copy this to .env and fill the values for local development

# AWS credentials (local dev only — use IAM roles in production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# From: terraform output queue_url
QUEUE_URL=

# From: terraform output ecs_cluster_arn
ECS_CLUSTER_ARN=

# From: terraform output ecs_task_definition_arn
ECS_TASK_DEFINITION_ARN=

# From: terraform output ecs_subnet_ids (comma-separated)
ECS_SUBNETS=

# App port
PORT=3000
