# Backend environment variables example
# Copy this to .env and fill the values for local development

# AWS configuration (required if running locally)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Optional if using temporary credentials
# AWS_SESSION_TOKEN=YOUR_AWS_SESSION_TOKEN

# SQS queue URL created by Terraform (example value is present in .env)
QUEUE_URL=Your_SQS_Queue_URL

# App port
PORT=3000
