# Frontend environment variables example
# Copy this to .env.local and fill the values for local development.
# These are used ONLY by the server-side Route Handlers (app/api/*) — they are
# never exposed to the browser.

# AWS credentials (local dev only — use an IAM role in production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# From: terraform output raw_bucket
RAW_BUCKET=

# From: terraform output processed_bucket
PROCESSED_BUCKET=
